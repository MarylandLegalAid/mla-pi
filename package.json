{
  "name": "mla-pi",
  "version": "0.1.0",
  "description": "Turnkey pi coding agent workflow for Maryland Legal Aid: plan, build, and ship with OpenRouter-routed subagents.",
  "license": "MIT",
  "author": "Maryland Legal Aid",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarylandLegalAid/mla-pi.git"
  },
